# Copy this file to report-proxmox-state.conf and fill it in.
# The real file is gitignored because it can contain OAuth credentials.
# Values that describe the Proxmox setup itself live in config/infra.yaml.

# Required: Proxmox host address over Tailscale used by the GitHub Actions runners.
TS_PROXMOX_HOSTNAME=
# Optional: set to pin the Proxmox host key fingerprint (for example the output
# of "ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub").
PROXMOX_HOST_KEY_FINGERPRINT=
# Required by every GitHub Actions deployment job to join the Tailscale network.
# Create an OAuth client in Tailscale with permission to authenticate the tagged runner.
# Set these here or export them in your shell (exported values are used when empty).
TS_OAUTH_CLIENT_ID=
TS_OAUTH_SECRET=
# Required: local private-key path, or "generate" to create a temporary Ed25519 key automatically.
GITHUB_PROXMOX_SSH_KEY_PATH=generate

# Optional: S3 backend (for example Cloudflare R2) that stores the Terraform state.
# Leave blank to keep the default Git-only state storage on the terraform-state branch.
TF_STATE_S3_URL=
TF_STATE_S3_NAME=
# Optional: set to false to stop uploading the Terraform state to the git branch; the state is kept in S3 instead.
TERRAFORM_STATE_TO_GIT=true
